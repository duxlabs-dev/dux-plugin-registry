{
    "id": "duxHerdrFleet",
    "name": "Dux Herdr Fleet",
    "capabilities": [
        "dankbar-widget",
        "monitoring",
        "ipc"
    ],
    "category": "monitoring",
    "repo": "https://github.com/arqueon/dux-herdr-fleet",
    "description": "Multi-machine and workspace agent monitor for herdr and optional Herdr Desktop App (hc/herdr-app) with live status, context tokens, machine filter and pane focus (compositor window focus is Niri-only). Fork of Mor-dev/herdr-agent-monitor.",
    "version": "1.0.0",
    "author": "arqueon",
    "icon": "hub",
    "type": "widget",
    "component": "./HerdrFleetWidget.qml",
    "settings": "./HerdrFleetSettings.qml",
    "permissions": [
        "process",
        "settings_read",
        "settings_write"
    ],
    "requires_dms": ">=2.0.0",
    "dependencies": [
        "herdr",
        "python3",
        "jq"
    ],
    "compositors": [
        "any"
    ],
    "distro": [
        "any"
    ],
    "screenshot": "https://raw.githubusercontent.com/arqueon/dux-herdr-fleet/main/assets/screenshot.png"
}
